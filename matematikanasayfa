  }
  td { padding: 9px 14px; border: 1px solid var(--border); color: #c8ccda; }
  tr:nth-child(even) td { background: rgba(255,255,255,0.02); }

  /* Steps */
  .steps { margin: 20px 0; }
  .step {
    display: flex;
    gap: 16px;
    margin-bottom: 16px;
    align-items: flex-start;
  }
  .step-num {
    width: 28px; height: 28px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 12px;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .s3 .step-num { background: rgba(61,214,172,0.15); color: var(--accent4); border: 1px solid rgba(61,214,172,0.3); }
  .s4 .step-num { background: rgba(247,90,142,0.15); color: var(--accent3); border: 1px solid rgba(247,90,142,0.3); }
  .step-body { flex: 1; color: #c8ccda; font-size: 14px; padding-top: 4px; }

  /* Grid 2 */
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 20px 0; }
  @media(max-width: 600px) { .grid2 { grid-template-columns: 1fr; } }
  .card {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 18px;
  }
  .card-title { font-size: 13px; font-weight: 700; color: #fff; margin-bottom: 8px; }
  .card p { font-size: 13px; color: var(--muted); margin: 0; }

  /* Highlight */
  .hl { color: #fff; font-weight: 600; }
  .mono { font-family: 'JetBrains Mono', monospace; font-size: 13.5px; background: rgba(255,255,255,0.06); padding: 2px 6px; border-radius: 4px; }

  /* Footer */
  .footer {
    text-align: center;
    padding: 40px 24px;
    color: var(--muted);
    font-size: 12px;
  }

  /* Divider */
  .divider { width: 40px; height: 3px; border-radius: 2px; margin: 20px 0; }
  .s1 .divider { background: var(--accent1); }
  .s2 .divider { background: var(--accent2); }
  .s3 .divider { background: var(--accent4); }
  .s4 .divider { background: var(--accent3); }
</style>
