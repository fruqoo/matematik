    --surface: #1a1d27;
    --surface2: #222636;
    --border: #2e3348;
    --accent1: #4f8ef7;
    --accent2: #7c5af7;
    --accent3: #f75a8e;
    --accent4: #3dd6ac;
    --accent5: #f7a843;
    --text: #e8eaf2;
    --muted: #8890a8;
    --formula-bg: #12151f;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Sora', sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.75;
    font-size: 15px;
  }

  /* Header */
  .hero {
    background: linear-gradient(135deg, #0f1117 0%, #1a1030 50%, #0a1a2e 100%);
