  .info-icon { font-size: 20px; flex-shrink: 0; margin-top: 1px; }
  .info-box.tip { background: rgba(79,142,247,0.07); border: 1px solid rgba(79,142,247,0.2); }
  .info-box.warn { background: rgba(247,168,67,0.07); border: 1px solid rgba(247,168,67,0.2); }
  .info-box p { margin: 0; font-size: 13.5px; }

  /* Table */
  .table-wrap { overflow-x: auto; margin: 20px 0; }
  table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  th {
    background: var(--surface2);
    padding: 10px 14px;
    text-align: left;
    font-weight: 600;
    color: var(--muted);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
