  .s1 .example-head { color: var(--accent1); }
  .s2 .example-head { color: var(--accent2); }
  .s3 .example-head { color: var(--accent4); }
  .s4 .example-head { color: var(--accent3); }
  .example p { margin: 0; color: #c8ccda; font-size: 14px; }
